<?xml version="1.0" encoding="UTF-8"?>
<schema xmlns="http://www.concrete5.org/doctrine-xml/0.5"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.concrete5.org/doctrine-xml/0.5 http://concrete5.github.io/doctrine-xml/doctrine-xml-0.5.xsd">
    
    <table name="btNsMailchimpSubscriptionForm">
        <field name="bID" type="integer">
            <unsigned/>
            <key/>
        </field>
        <field name="subscriptionListId" type="string" size="255" />
        <field name="title" type="string" size="255" />
        <field name="content" type="text" />
        <field name="placeholder" type="string" size="255" />
        <field name="buttonText" type="string" size="255" />
        <field name="helpText" type="text" />
        <field name="successMessage" type="text" />
        <field name="ajaxSubmission", type="integer" size="1">
            <unsigned />
            <default value="0" />
        </field>
    </table>

</schema>